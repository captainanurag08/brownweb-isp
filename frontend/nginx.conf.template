server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Static assets must NEVER fall back to index.html.
  # If an asset is missing, return 404 instead of HTML.
  location ~* \.(?:js|mjs|css|map|json|wasm|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|otf)$ {
    try_files $uri =404;

    access_log off;

    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # API
  location /api/ {
    proxy_pass ${BACKEND_ORIGIN};

    proxy_http_version 1.1;

    proxy_ssl_server_name on;
    proxy_ssl_name brownweb-isp.onrender.com;

    proxy_set_header Host brownweb-isp.onrender.com;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Cookie $http_cookie;
    proxy_set_header Authorization $http_authorization;

    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
  }

  # WebSocket
  location /ws {
    proxy_pass ${BACKEND_ORIGIN};

    proxy_http_version 1.1;

    proxy_ssl_server_name on;
    proxy_ssl_name brownweb-isp.onrender.com;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Host brownweb-isp.onrender.com;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Cookie $http_cookie;
    proxy_set_header Authorization $http_authorization;

    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
  }

  # Health/static special files
  location = /robots.txt {
    try_files $uri =404;
    access_log off;
  }

  location = /manifest.json {
    try_files $uri =404;
    access_log off;
  }

  location = /service-worker.js {
    try_files $uri =404;
    access_log off;

    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  # React SPA
  location / {
    try_files $uri $uri/ /index.html;
  }
}
